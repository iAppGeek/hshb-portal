# Copy to .env (gitignored) and fill in.

# Microsoft 365 admin account used by Connect-ExchangeOnline (optional; you
# will be asked to sign in either way, this just pre-fills the account).
M365_ADMIN_UPN=admin@example.org

# Supabase CLI access token (optional if you have run `supabase login`).
# SUPABASE_ACCESS_TOKEN=

# Folder containing the linked Supabase project (defaults to the repo root).
# SUPABASE_WORKDIR=

# Local settings for scripts/m365/students. Copy to .env (gitignored, never
# committed) and fill in: cp .env.example .env
# Every setting is optional.

# Microsoft 365 admin account to sign in with. Only printed as a reminder
# before the Microsoft sign-in window opens.
M365_ADMIN_UPN=admin@example.org

# Initial password for NEW student accounts (they must change it at first
# sign-in). Leave unset to give each new account its own random password.
# Never commit it: keep it here in .env only.
# M365_STUDENT_INITIAL_PASSWORD=

# Supabase CLI access token (optional if you have run `supabase login`).
# SUPABASE_ACCESS_TOKEN=

# Folder containing the linked Supabase project (defaults to the repo root).
# SUPABASE_WORKDIR=

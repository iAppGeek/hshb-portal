# Copy to .env.local
#
# Google Analytics
NEXT_PUBLIC_GA_ID=
#
# NextAuth
AUTH_SECRET=
# Base URL of this app, e.g. http://localhost:3000 or https://portal.hshb.org.uk
AUTH_URL=
#
# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
#
# Postgres (Drizzle). Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: the Supabase Supavisor transaction pooler URL (port 6543)
DATABASE_URL=
#
# Web Push (VAPID) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
#
# Cloudflare Turnstile (public /register form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME= # production only: portal.hshb.org.uk

# Copy to .env.local
#
# Google Analytics
NEXT_PUBLIC_GA_ID=
#
# NextAuth
AUTH_SECRET=
# Base URL of this app, e.g. http://localhost:3000 or https://portal.hshb.org.uk
AUTH_URL=
#
# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
#
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# Web Push (VAPID) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
#
# Document file storage — selects the live backend (only 'sharepoint' is built).
# Not needed to build or run tests; only to exercise a live upload.
FILE_STORAGE_PROVIDER=sharepoint
# Microsoft Graph (client-credentials / app-only). The app must be granted
# Sites.Selected on the ONE target SharePoint document library — never
# Files.ReadWrite.All. Requires a one-time admin consent + site grant.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
